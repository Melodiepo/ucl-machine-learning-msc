         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">BMC Bioinformatics, 2020, doi:10.1186/s12859-020-3466-1</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Cardiotoxicity</rdf:li>
               <rdf:li>hiPSC-derived cardiomyocytes</rdf:li>
               <rdf:li>High-throughput screening</rdf:li>
               <rdf:li>Image analysis</rdf:li>
               <rdf:li>Phenotype quantification</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Automated image analysis system for studying cardiotoxicity in human pluripotent stem cell-Derived cardiomyocytes</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Lu Cao</rdf:li>
               <rdf:li>Andries van der Meer</rdf:li>
               <rdf:li>Fons J. Verbeek</rdf:li>
               <rdf:li>Robert Passier</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
